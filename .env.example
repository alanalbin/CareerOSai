# =====================================================================
# Career OS — Environment Configuration
# =====================================================================

# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
# In production, provide a standard PostgreSQL connection URL:
# DATABASE_URL=postgresql://career_os_user:password@localhost:5432/career_os_db
# If left unset, Career OS automatically initializes and uses persistent local PostgreSQL via PGlite in ./data/vantage_pg
DATABASE_URL=

# Authentication & Session Security
# Generate a strong 64-character secret using: openssl rand -hex 32
AUTH_SECRET=
JWT_EXPIRES_IN=7d

# File Storage & Uploads
# Local directory for uploaded resumes, certificates, transcripts, and portfolios
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Document Intelligence (PaddleOCR Microservice)
# URL of the Python PaddleOCR FastAPI microservice (see services/ocr/python_service)
OCR_SERVICE_URL=http://localhost:8000
OCR_CONFIDENCE_THRESHOLD=0.85

# AI & LLM Engine (Qwen3 Integration)
# Compatible with Alibaba Cloud DashScope / OpenAI API format
QWEN_API_KEY=
QWEN_API_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max

# Email & Notifications (SMTP)
# Used for verification codes, password resets, and recruiter contact requests
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Career OS <no-reply@example.com>"
